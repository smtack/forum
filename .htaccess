RewriteEngine On

# Change to / if serving from root
RewriteBase /forum/

Options -Indexes

# Explicitly handle /admin and /admin/ — internal rewrite only
RewriteRule ^admin/?$ public/admin/index.php [L]
RewriteRule ^admin(/.*)?$ public/admin$1 [L]

# Serve everything else from public/ (skip admin)
RewriteCond %{REQUEST_URI} !^/forum/admin/
RewriteCond %{REQUEST_URI} !^/forum/public/
RewriteRule ^(.*)$ public/$1 [L]